{
  "version": 1,
  "good": "wheat",
  "era": "c.1300",
  "description": "Historical breadbasket and anti-breadbasket assumptions for EU5-definition wheat (~Triticum staple). Used only as post-hoc validation — never as training labels or region multipliers.",
  "notes": [
    "Selectors use agronomic/geographic filters (bbox, climate, vegetation, river), not EU5 region IDs as causal features.",
    "region filters are convenience geography for evaluation only.",
    "Positive-only medians ignore zeros so hostile deserts do not drag irrigated corridors down."
  ],
  "tests": [
    {
      "id": "T_nile_above_britain",
      "group": "rank",
      "description": "Nile irrigated corridor out-yields English farmland (Watson vs BAHS intensity).",
      "expect": "median_a_gt_median_b",
      "a": {
        "name": "nile_river",
        "bbox": [21.0, 32.5, 29.0, 35.0],
        "has_river": true,
        "positive_only": true
      },
      "b": {
        "name": "britain_farmland",
        "region": "great_britain_region",
        "vegetation": "farmland",
        "positive_only": true
      }
    },
    {
      "id": "T_nile_above_maghreb",
      "group": "rank",
      "description": "Nile basin intensity above Maghreb coastal wheat country.",
